# Optional: Add this SECRET in Vercel Project Settings > Environment Variables.
# Get your own key from an appropriately licensed train data provider.
# Example adapter supports irctc.dev, a THIRD-PARTY provider, not official IRCTC.
RAIL_API_KEY=
# Optional: Get a free API key from https://openrouteservice.org/dev/#/signup
# Without this, road lookups use public OSRM demo, which is not designed for production traffic.
ORS_API_KEY=
